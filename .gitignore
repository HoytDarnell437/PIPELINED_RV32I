# ==========================================
# Vivado Project Clutter & Temporary Files
# ==========================================
*.log
*.jou
*.str
*.os
*.ini
.Xil/
vivado_pid*.str

# Ignore Vivado run directories (where synthesis and simulation run)
*.runs/
*.dir/
*.gen/
*.sim/
*.ip_user_files/
*.hw/
*.cache/
*.ioplanning/

# Ignore compiled simulation snapshots and wave outputs
*.wdb
*.wcfg
*.vcd

# Ignore SDK / Vitis artifacts if you use them later
.metadata/
*.sdk/
*.pif

# ==========================================
# Backup and Autosave Files
# ==========================================
*~
.#*
.*.swp
*.bak

# ==========================================
# OS and Editor Specific Files
# ==========================================
.DS_Store
Thumbs.db
.vscode/
.idea/

# ==========================================
# Project Exceptions (CRITICAL)
# ==========================================
# Vivado needs the .xpr project file and the actual constraints/IP sources.
# These rules ensure they never get accidentally ignored.
!*.xpr
!*.xdc
!*.xci
!*.xcix
